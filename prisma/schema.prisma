generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  admin_pusat
  admin_cabang
  teknisi

  @@map("user_role")
}

enum PenugasanStatus {
  pending
  proses
  selesai
  dibatalkan

  @@map("penugasan_status")
}

enum KondisiWmLama {
  normal
  macet
  kaca_pecah
  berembun_parah
  bodi_korosi

  @@map("kondisi_wm_lama")
}

enum StatusValidasi {
  menunggu
  disetujui
  ditolak

  @@map("status_validasi")
}

enum TahapPenggantian {
  data_wm_lama
  menunggu_validasi

  @@map("tahap_penggantian")
}

model Unit {
  id_unit   String @id @default(uuid()) @db.Char(36)
  kode_unit String @unique @db.VarChar(20)
  nama_unit String @db.VarChar(100)

  users      User[]         @relation("UserUnit")
  pengiriman PengirimanWm[] @relation("UnitTujuan")
  pelanggan  Pelanggan[]
  penugasan  Penugasan[]

  @@map("unit")
}

model TipeTarif {
  id_tarif   String @id @default(uuid()) @db.Char(36)
  kode_tarif String @unique @db.VarChar(20)
  nama_tarif String @db.VarChar(100)

  pelanggan Pelanggan[]

  @@map("tipe_tarif")
}

model MerkWm {
  id_merk  String @id @default(uuid()) @db.Char(36)
  kode_wm  String @unique @db.VarChar(20)
  merk_wm  String @db.VarChar(50)
  wm_digit Int

  pengiriman_detail PengirimanWmDetail[]
  penggantian       PenggantianWm[]

  @@map("merk_wm")
}

model User {
  id_user  String   @id @default(uuid()) @db.Char(36)
  id_unit  String?  @db.Char(36)
  fullname String   @db.VarChar(100)
  username String   @unique @db.VarChar(50)
  password String   @db.VarChar(255)
  role     UserRole

  unit Unit? @relation("UserUnit", fields: [id_unit], references: [id_unit])

  pengiriman_dibuat PengirimanWm[]  @relation("PengirimanCreator")
  penugasan_dibuat  Penugasan[]     @relation("PenugasanCreator")
  penugasan_teknisi Penugasan[]     @relation("PenugasanTeknisi")
  bap_teknisi       PenggantianWm[] @relation("PenggantianTeknisi")

  @@map("user")
}

model PengirimanWm {
  id_pengiriman    String    @id @default(uuid()) @db.Char(36)
  no_pengiriman    String    @unique @db.VarChar(50)
  id_unit_tujuan   String    @db.Char(36)
  tgl_pengiriman   DateTime  @db.Date
  total_wm         Int       @default(0)
  catatan          String?   @db.Text
  id_user_pencatat String    @map("id_user_pusat") @db.Char(36)
  created_at       DateTime? @default(now()) @db.DateTime(0)

  unit_tujuan   Unit @relation("UnitTujuan", fields: [id_unit_tujuan], references: [id_unit])
  user_pencatat User @relation("PengirimanCreator", fields: [id_user_pencatat], references: [id_user])

  details PengirimanWmDetail[]

  @@map("pengiriman_wm")
}

model PengirimanWmDetail {
  id_detail     String @id @default(uuid()) @db.Char(36)
  id_pengiriman String @db.Char(36)
  id_merk       String @db.Char(36)
  ukuran_dn     String @default("1/2") @db.VarChar(20)
  jumlah        Int

  pengiriman PengirimanWm @relation(fields: [id_pengiriman], references: [id_pengiriman], onDelete: Cascade)
  merk       MerkWm       @relation(fields: [id_merk], references: [id_merk])

  @@map("pengiriman_wm_detail")
}

model Pelanggan {
  id_pelanggan      String @id @default(uuid()) @db.Char(36)
  id_pelanggan_pdam String @unique @db.VarChar(50)

  id_unit          String  @db.Char(36)
  nama             String  @db.VarChar(100)
  alamat           String  @db.VarChar(255)
  id_tarif         String  @db.Char(36)
  wm_no_seri_aktif String? @db.VarChar(50)

  unit  Unit      @relation(fields: [id_unit], references: [id_unit])
  tarif TipeTarif @relation(fields: [id_tarif], references: [id_tarif])

  penugasan Penugasan[]

  @@map("pelanggan")
}

model Penugasan {
  id_penugasan      String          @id @default(uuid()) @db.Char(36)
  nomor_spk         String          @unique @db.VarChar(50)
  id_pelanggan      String          @db.Char(36)
  id_unit           String          @db.Char(36)
  tgl_penugasan     DateTime        @default(now()) @db.DateTime(0)
  alasan            String          @db.VarChar(255)
  id_user_penugasan String          @db.Char(36)
  status            PenugasanStatus @default(pending)
  id_teknisi        String?         @db.Char(36)

  pelanggan Pelanggan @relation(fields: [id_pelanggan], references: [id_pelanggan])
  unit      Unit      @relation(fields: [id_unit], references: [id_unit])

  pembuat User  @relation("PenugasanCreator", fields: [id_user_penugasan], references: [id_user])
  teknisi User? @relation("PenugasanTeknisi", fields: [id_teknisi], references: [id_user])

  penggantian PenggantianWm[]

  @@map("penugasan")
}

model PenggantianWm {
  id_penggantian String @id @default(uuid()) @db.Char(36)
  id_penugasan   String @db.Char(36)

  // Data WM lama - diisi pada tahap pertama
  no_seri_wm_lama       String?       @unique @db.VarChar(50)
  stand_wm_lama         Int?
  kondisi_fisik_wm_lama KondisiWmLama
  path_image_wm_lama    String?       @db.VarChar(255)

  // Data WM baru - diisi pada tahap penyelesaian
  no_seri_wm_baru    String?   @unique @db.VarChar(50)
  stand_awal_wm_baru Int?
  path_image_wm_baru String?   @db.VarChar(255)
  tgl_penggantian    DateTime? @db.DateTime(0)
  id_merk            String?   @db.Char(36)

  id_teknisi        String           @db.Char(36)
  tahap_penggantian TahapPenggantian @default(data_wm_lama)
  status_validasi   StatusValidasi?
  catatan_validasi  String?          @db.Text

  penugasan Penugasan @relation(fields: [id_penugasan], references: [id_penugasan])
  teknisi   User      @relation("PenggantianTeknisi", fields: [id_teknisi], references: [id_user])
  merk      MerkWm?   @relation(fields: [id_merk], references: [id_merk])

  @@map("penggantian_wm")
}

model SpkSequence {
  tanggal     String @id @db.Char(8)
  last_number Int    @default(0)

  @@map("spk_sequences")
}
